# Scaffold .gitignore for a PSXRecomp game repository (New Project Layout).
# Based on psxrecomp/tools/new_project_layout/templates/gitignore.in.
# Differences: disc_probe.json is ignored, and the config, env, capture and
# image patterns are broader.

# Build outputs
/build/
/build-*/
/out/
/.happypath/

# generated/ is COMMITTED: releases ship the compiled game, and CI builds it
# from the game C in this repo (psxrecomp_cli.py generate, then git add
# generated). Never ignore it. Only the framework submodule's own generated/
# (BIOS backends) stays untracked, and that is the submodule's rule.
# psxrecomp_cli.py work areas (overlay toolchain download, static overlay
# shard evidence -- the latter holds bytes read from the disc).
/.cache/

# Release packaging
/release-stage/
/dist/
*.zip

# Local PlayStation assets (never commit dumps / BIOS)
/bios/
/isos/
/saves/
/prepared_disc/
/disc/
.settings/

# Disc / image / memcard formats
*.bin
*.cue
*.iso
*.img
*.sub
*.ccd
*.mcd
*.mcr
*.chd
*.car
SCPH*.BIN
# Any letter case, plus other image formats
*.[bB][iI][nN]
*.[cC][uU][eE]
*.[iI][sS][oO]
*.[cC][hH][dD]
*.[iI][mM][gG]
*.[eE][cC][mM]
*.[pP][bB][pP]

# Local path/config stubs (bios.cfg, disc.cfg, rom.cfg, recomp-ui input.cfg)
# and env files the runtime reads (they can relocate the capture store)
*.cfg
settings.toml
.psxrecomp.env
.env

# Local analysis scratch — GPU frame captures / parity dumps (the default
# --out for tools/gpu_frame_*.py and gpu_parity.py) and asset rips pulled off
# the disc. Multi-hundred-MB binaries land here and are rejected by GitHub's
# 100 MB blob limit, and ripped disc content must never be committed at all.
/analysis/

# Ghidra / local analysis
/ghidra/projects/
*.gpr
*.rep/
*.lock
*.lock~

# Editor / cache
.vs/
.vscode/
*.user
*.log
.DS_Store
__pycache__/
CMakeCache.txt
CMakeFiles/
compile_commands.json

# Runtime artifacts from psx-runtime launches
psx_crash.txt
psx_last_run_report.json
psx_screenshot.bmp
psx_freeze_heartbeat.json
.psxrecomp_last_generate
.psxrecomp_write_probe
starvation_dump.jsonl
# Overlay capture store at any depth: verbatim game code (plus its .d history
# and the overlay_captures.addendum.jsonl capture history)
overlay_captures.*

# Diagnostic dumps (root-level) — keep catalog trackable. disc_probe.json
# stays ignored: it records the absolute local cue_path.
/*.json
/*.bmp
/*.png
!/catalog_identity.json
!/.recomp.json
